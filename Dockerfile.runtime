# syntax=docker/dockerfile:1.7
# Fast local/CI runtime packaging after `gradlew bootJar` has produced the artifact.
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
RUN useradd --system --uid 10001 vistay
COPY --from=artifact /user-0.1.0-SNAPSHOT.jar /app/app.jar
USER 10001
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "/app/app.jar"]
